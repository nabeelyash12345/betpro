{
  "expo": {
    "name": "Bprolive",
    "slug": "Bprolive",
    "version": "17.17.17",
    "orientation": "portrait",
    "icon": "./assets/lllllllllllll.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/Bold BP logo on black background.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "cameraPermission": "This app uses the camera to take photos.",
          "photosPermission": "This app accesses your gallery to select images."
        }
      ]
    ],
    "ios": {
      "supportsTablet": true,
      "package": "com.betpro.myfirebaseapp"
    },
    "android": {
       "versionCode": 17,
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/lllllllllllll.png",
        "backgroundImage": "./assets/lllllllllllll.png",
        "monochromeImage": "./assets/lllllllllllll.png"
      },
      "package": "com.betpro.myfirebaseapp",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "f5fbd00c-5d09-4d27-9cb1-2605588e48dd"
      }
    }
  }
}
